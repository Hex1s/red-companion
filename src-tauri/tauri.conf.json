{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Red Companion",
  "version": "0.1.0",
  "identifier": "app.red-companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Red Companion",
        "width": 1280,
        "height": 720,
        "minWidth": 768,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/64x64.png",
      "tooltip": "Red Companion"
  }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwOTg5OUFEOEVBMTNEN0UKUldSK1BhR09yWm1ZUUYzVEYwRGhxOXNvTVRWaWxOeGRjK1p3MDFHekEzRlF4Y05ya0lUYmRNTk0K",
      "endpoints": [
        "https://red-companion.ru/api/v1/app/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
