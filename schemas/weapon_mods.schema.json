{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collection",
  "description": "A versioned set of entries of one type, the unit of sync with the future API.",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WeaponMod"
      }
    },
    "name": {
      "description": "Collection name, e.g. `critical_injuries`.",
      "type": "string"
    },
    "version": {
      "description": "Bumped by hand whenever the content changes.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "name",
    "version",
    "entries"
  ],
  "$defs": {
    "Source": {
      "description": "Where a value comes from in the rulebook.",
      "type": "object",
      "properties": {
        "page": {
          "description": "Printed page number (PDF page minus one).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "page"
      ]
    },
    "WeaponMod": {
      "description": "A weapon modification (p. 343-344). Every non-exotic ranged weapon has `MOD_SLOTS` slots.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "pack": {
          "type": "string",
          "default": "core"
        },
        "price": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "skills": {
          "description": "Skill ids of the weapons it fits (ranged, never exotic).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "slots": {
          "description": "Slots it takes: 1, or 2 where the book says so.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "summary": {
          "type": "string"
        },
        "uuid": {
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "code",
        "name",
        "price",
        "slots",
        "skills",
        "summary",
        "source"
      ]
    }
  }
}
