{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collection",
  "description": "A versioned set of entries of one type, the unit of sync with the future API.",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StreetDrug"
      }
    },
    "name": {
      "description": "Collection name, e.g. `critical_injuries`.",
      "type": "string"
    },
    "version": {
      "description": "Bumped by hand whenever the content changes.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "name",
    "version",
    "entries"
  ],
  "$defs": {
    "Source": {
      "description": "Where a value comes from in the rulebook.",
      "type": "object",
      "properties": {
        "page": {
          "description": "Printed page number (PDF page minus one).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "page"
      ]
    },
    "StreetDrug": {
      "description": "A street drug (p. 357-358): what one dose does, and what the addiction does.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "duration_hours": {
          "description": "How long the primary effect lasts, hours.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "pack": {
          "type": "string",
          "default": "core"
        },
        "price": {
          "description": "Price of one dose in eurobucks.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "primary": {
          "description": "The primary effect, a short summary in the content language.",
          "type": "string"
        },
        "secondary": {
          "description": "The secondary effect (addiction), a short summary.",
          "type": "string"
        },
        "secondary_dv": {
          "description": "DV of the check against the secondary effect (addiction).",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "uuid": {
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "code",
        "name",
        "price",
        "duration_hours",
        "secondary_dv",
        "primary",
        "secondary",
        "source"
      ]
    }
  }
}
