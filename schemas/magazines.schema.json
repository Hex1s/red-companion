{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collection",
  "description": "A versioned set of entries of one type, the unit of sync with the future API.",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MagazineRow"
      }
    },
    "name": {
      "description": "Collection name, e.g. `critical_injuries`.",
      "type": "string"
    },
    "version": {
      "description": "Bumped by hand whenever the content changes.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "name",
    "version",
    "entries"
  ],
  "$defs": {
    "MagazineRow": {
      "description": "Magazine sizes of a weapon class (p. 344): standard, extended and drum.",
      "type": "object",
      "properties": {
        "drum": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "extended": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "id": {
          "description": "`code` of the weapon in the catalog.",
          "type": "string"
        },
        "pack": {
          "type": "string",
          "default": "core"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "standard": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "required": [
        "id",
        "standard",
        "extended",
        "drum",
        "source"
      ]
    },
    "Source": {
      "description": "Where a value comes from in the rulebook.",
      "type": "object",
      "properties": {
        "page": {
          "description": "Printed page number (PDF page minus one).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "page"
      ]
    }
  }
}
