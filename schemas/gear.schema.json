{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collection",
  "description": "A versioned set of entries of one type, the unit of sync with the future API.",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GearItem"
      }
    },
    "name": {
      "description": "Collection name, e.g. `critical_injuries`.",
      "type": "string"
    },
    "version": {
      "description": "Bumped by hand whenever the content changes.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "name",
    "version",
    "entries"
  ],
  "$defs": {
    "GearItem": {
      "description": "One line of the gear list (p. 351) with its description (p. 352-355). The text is a short\nsummary in the content language, not the book's wording.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "pack": {
          "type": "string",
          "default": "core"
        },
        "price": {
          "description": "Price in eurobucks; the price category is derived from it (see `price_category_of`).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "source": {
          "description": "Page of the description.",
          "$ref": "#/$defs/Source"
        },
        "summary": {
          "type": "string"
        },
        "uuid": {
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "code",
        "name",
        "price",
        "summary",
        "source"
      ]
    },
    "Source": {
      "description": "Where a value comes from in the rulebook.",
      "type": "object",
      "properties": {
        "page": {
          "description": "Printed page number (PDF page minus one).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "page"
      ]
    }
  }
}
