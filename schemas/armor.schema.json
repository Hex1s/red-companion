{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collection",
  "description": "A versioned set of entries of one type, the unit of sync with the future API.",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Armor"
      }
    },
    "name": {
      "description": "Collection name, e.g. `critical_injuries`.",
      "type": "string"
    },
    "version": {
      "description": "Bumped by hand whenever the content changes.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "name",
    "version",
    "entries"
  ],
  "$defs": {
    "Armor": {
      "description": "Armor type (book p. 184-185). Any type can be worn on the head or on the\nbody; armor does not stack: only the best SP of an area counts.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name_key": {
          "type": "string"
        },
        "penalty": {
          "description": "Penalty to REF, DEX and MOVE (0, 2 or 4); applied once, the highest\nof the worn armor.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "sp": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "required": [
        "id",
        "name_key",
        "sp",
        "penalty",
        "source"
      ]
    },
    "Source": {
      "description": "Where a value comes from in the rulebook.",
      "type": "object",
      "properties": {
        "page": {
          "description": "Printed page number (PDF page minus one).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "page"
      ]
    }
  }
}
