{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collection",
  "description": "A versioned set of entries of one type, the unit of sync with the future API.",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CoverMaterial"
      }
    },
    "name": {
      "description": "Collection name, e.g. `critical_injuries`.",
      "type": "string"
    },
    "version": {
      "description": "Bumped by hand whenever the content changes.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "name",
    "version",
    "entries"
  ],
  "$defs": {
    "CoverMaterial": {
      "description": "Cover material at a given thickness (book p. 182). Combinations with 0 HP\n(thin drywall) are not cover and are not stored.",
      "type": "object",
      "properties": {
        "hp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "description": "Unique per material and thickness (e.g. `metal_thick`).",
          "type": "string"
        },
        "name_key": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "thickness": {
          "$ref": "#/$defs/CoverThickness"
        }
      },
      "required": [
        "id",
        "name_key",
        "thickness",
        "hp",
        "source"
      ]
    },
    "CoverThickness": {
      "type": "string",
      "enum": [
        "thick",
        "thin"
      ]
    },
    "Source": {
      "description": "Where a value comes from in the rulebook.",
      "type": "object",
      "properties": {
        "page": {
          "description": "Printed page number (PDF page minus one).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "page"
      ]
    }
  }
}
