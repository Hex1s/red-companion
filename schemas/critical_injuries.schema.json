{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collection",
  "description": "A versioned set of entries of one type, the unit of sync with the future API.",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CriticalInjury"
      }
    },
    "name": {
      "description": "Collection name, e.g. `critical_injuries`.",
      "type": "string"
    },
    "version": {
      "description": "Bumped by hand whenever the content changes.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "name",
    "version",
    "entries"
  ],
  "$defs": {
    "BodyArea": {
      "type": "string",
      "enum": [
        "body",
        "head"
      ]
    },
    "CriticalInjury": {
      "description": "A critical injury table row (2d6, separate tables for body and head).",
      "type": "object",
      "properties": {
        "area": {
          "$ref": "#/$defs/BodyArea"
        },
        "death_save_penalty": {
          "description": "The injury raises the death-save penalty by 1 (\"Штраф Спасброска\nувеличивается на 1\").",
          "type": "boolean"
        },
        "effect_key": {
          "type": "string"
        },
        "first_aid": {
          "description": "Ways to stabilise the injury until the end of the day; any one option\nworks. Empty when first aid is impossible (\"НЕТ\" in the table).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TreatmentOption"
          }
        },
        "id": {
          "description": "Stable id, never translated (e.g. `broken_leg`).",
          "type": "string"
        },
        "name_key": {
          "type": "string"
        },
        "quick_fix_removes_effect": {
          "description": "\"Quick Fix removes the effect\" instead of a regular treatment.",
          "type": "boolean"
        },
        "roll": {
          "description": "2d6 result, 2..=12.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "treatment": {
          "description": "Ways to heal the injury for good; any one option works. Empty when the\ntable only offers a quick fix (see `quick_fix_removes_effect`).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TreatmentOption"
          }
        }
      },
      "required": [
        "id",
        "area",
        "roll",
        "name_key",
        "effect_key",
        "first_aid",
        "treatment",
        "quick_fix_removes_effect",
        "death_save_penalty",
        "source"
      ]
    },
    "Source": {
      "description": "Where a value comes from in the rulebook.",
      "type": "object",
      "properties": {
        "page": {
          "description": "Printed page number (PDF page minus one).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "page"
      ]
    },
    "TreatmentOption": {
      "description": "One way to treat an injury: skill check against a DV.",
      "type": "object",
      "properties": {
        "dv": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "skill": {
          "$ref": "#/$defs/TreatmentSkill"
        }
      },
      "required": [
        "skill",
        "dv"
      ]
    },
    "TreatmentSkill": {
      "description": "Medical skill that can treat an injury.",
      "type": "string",
      "enum": [
        "first_aid",
        "paramedic",
        "surgery"
      ]
    }
  }
}
