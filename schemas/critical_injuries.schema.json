{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collection",
  "description": "A versioned set of entries of one type, the unit of sync with the future API.",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CriticalInjury"
      }
    },
    "name": {
      "description": "Collection name, e.g. `critical_injuries`.",
      "type": "string"
    },
    "version": {
      "description": "Bumped by hand whenever the content changes.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "name",
    "version",
    "entries"
  ],
  "$defs": {
    "BodyArea": {
      "type": "string",
      "enum": [
        "body",
        "head"
      ]
    },
    "CriticalInjury": {
      "description": "A critical injury table row (2d6, separate tables for body and head).",
      "type": "object",
      "properties": {
        "area": {
          "$ref": "#/$defs/BodyArea"
        },
        "effect_key": {
          "type": "string"
        },
        "first_aid_dv": {
          "description": "First-aid DV; `None` when it cannot be treated that way.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "id": {
          "description": "Stable id, never translated (e.g. `broken_leg`).",
          "type": "string"
        },
        "name_key": {
          "type": "string"
        },
        "roll": {
          "description": "2d6 result, 2..=12.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "treatment_dv": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "required": [
        "id",
        "area",
        "roll",
        "name_key",
        "effect_key",
        "source"
      ]
    },
    "Source": {
      "description": "Where a value comes from in the rulebook.",
      "type": "object",
      "properties": {
        "page": {
          "description": "Printed page number (PDF page minus one).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "page"
      ]
    }
  }
}
