{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collection",
  "description": "A versioned set of entries of one type, the unit of sync with the future API.",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Shield"
      }
    },
    "name": {
      "description": "Collection name, e.g. `critical_injuries`.",
      "type": "string"
    },
    "version": {
      "description": "Bumped by hand whenever the content changes.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "name",
    "version",
    "entries"
  ],
  "$defs": {
    "Shield": {
      "description": "Portable shield, usable as cover with its own HP.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "hp": {
          "description": "`None` for a body used as a shield: its HP equal the BODY stat the\nperson had while alive.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "uuid": {
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "code",
        "name",
        "source"
      ]
    },
    "Source": {
      "description": "Where a value comes from in the rulebook.",
      "type": "object",
      "properties": {
        "page": {
          "description": "Printed page number (PDF page minus one).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "page"
      ]
    }
  }
}
